# Skopiuj do .env i uzupełnij klucze. Plik .env nie trafia do gita.

OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Aktualną nazwę modelu sprawdź na https://docs.claude.com/en/docs/about-claude/models
ANTHROPIC_MODEL=

# 1 = nie wywołuj Whispera (metryki czasowe z VAD działają normalnie)
MOCK_TRANSCRIPTION=0

# Retencja nagrań audio w dniach (metryki zostają na zawsze)
AUDIO_RETENTION_DAYS=30
