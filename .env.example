# Skopiuj ten plik jako .env i uzupełnij.
# Plik .env jest w .gitignore i nigdy nie trafia do repozytorium.

# Hasło do aplikacji. Wymagane przy uruchomieniu w Dockerze i przy hostingu.
# Przy uruchomieniu lokalnie (start.bat) nie jest potrzebne.
APP_PASSWORD=

# Klucz OpenAI (zaczyna się od sk-). Można go też wpisać później
# w aplikacji, w Ustawieniach - wtedy zostaw tę linię pustą.
OPENAI_API_KEY=

# Model używany do oceny wypowiedzi i generowania zadań.
OPENAI_LLM_MODEL=gpt-4o-mini
